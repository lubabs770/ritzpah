#!/usr/bin/env bash
#
# Kept so older instructions keep working. `ritzpah install` is the real thing.
#
#   ./install acid-vortex        install it and switch to it
#   ./install --all              install every theme, switch to none
#
# The --link mode this script used to have is gone: themes are copied, never
# symlinked. See THEME_JSON.md for why.

set -euo pipefail

REPO_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

if (( $# == 0 )); then
  exec "$REPO_DIR/ritzpah" list
fi

for arg in "$@"; do
  [[ $arg == -h || $arg == --help ]] && exec "$REPO_DIR/ritzpah" help
  [[ $arg == --link ]] && {
    echo "./install --link is gone; themes are copied now. See THEME_JSON.md." >&2
    exit 1
  }
done

if [[ $1 == --all ]]; then
  exec "$REPO_DIR/ritzpah" install --all
fi

exec "$REPO_DIR/ritzpah" install "$@" --set
