#version 300 es
// ISS Cockpit. Hyprland runs this over the whole composited output, so the
// cockpit is not a wallpaper -- it is in front of your windows, the way a
// canopy is in front of everything you look at through it.
//
// Hyprland supplies: tex (the composited screen), v_texcoord, time (seconds)
// and screen_size. That is the entire uniform set; there is no second
// sampler and no way to add one, which is why the telemetry arrives as PIXELS.
// See TELEMETRY.md.
//
// WHAT IS BAKED AND WHAT IS NOT. The constants below are written by
// themes/iss-cockpit/hyprland.lua at every Hyprland config load: the sun's
// direction, sidereal time, and a set of mean orbital elements, plus their
// rates. All linear, all boring, all exact. Everything non-linear -- the
// orbit, the subpoint, the terminator, the eclipse geometry -- is evaluated
// here, per frame, from `time`. So the cockpit stays correct between reloads
// for as long as the compositor runs and nothing has to fire on a timer.
//
// The DAEMON is separate and optional. When ritzpahd is running, the real
// station overwrites the propagation and the cabin gauges come alive. When it
// is not, this shader still flies the orbit on its own and says so.
precision highp float;

in vec2 v_texcoord;
uniform sampler2D tex;
uniform float time;
out vec4 fragColor;

// Resolution comes from textureSize(tex, 0) rather than the `screen_size`
// uniform. Hyprland does bind screen_size, but an unbound uniform reads as
// zero and every layout below would collapse silently into the corner --
// whereas the screen texture is the thing we are already sampling and cannot
// be wrong about. One less thing to be at the mercy of.
vec2 resolution() { return vec2(textureSize(tex, 0)); }

// ---------------------------------------------------------------- baked
const float T_LOAD   = @@T_LOAD@@;    // what `time` read when this was baked
const float GMST0    = @@GMST0@@;     // Greenwich mean sidereal time, degrees
const float GMST_R   = @@GMST_R@@;    // deg/day
const float SUNLON0  = @@SUNLON0@@;   // Sun ecliptic longitude, degrees
const float SUNLON_R = @@SUNLON_R@@;  // deg/day
const float EPS      = @@EPS@@;       // obliquity of the ecliptic, degrees

// Mean orbital elements for the fallback propagation, at bake time.
const float ISS_A      = @@ISS_A@@;      // semi-major axis, km
const float ISS_INC    = @@ISS_INC@@;    // inclination, degrees
const float ISS_RAAN0  = @@ISS_RAAN0@@;  // ascending node, degrees
const float ISS_RAAN_R = @@ISS_RAAN_R@@; // nodal regression, deg/day (negative)
const float ISS_U0     = @@ISS_U0@@;     // argument of latitude, degrees
const float ISS_U_R    = @@ISS_U_R@@;    // deg/day

// Palette, from the active theme. The telemetry drives motion; the theme
// drives colour. Nothing below hard-codes a hue.
const vec3 C_ACCENT = @@C_ACCENT@@;
const vec3 C_FG     = @@C_FG@@;
const vec3 C_MUTED  = @@C_MUTED@@;
const vec3 C_RED    = @@C_RED@@;
const vec3 C_ORANGE = @@C_ORANGE@@;
const vec3 C_GREEN  = @@C_GREEN@@;
const vec3 C_CYAN   = @@C_CYAN@@;
const vec3 C_BLUE   = @@C_BLUE@@;

// ---------------------------------------------------------------- knobs
const float PANEL_H   = 0.085;  // instrument strip height, fraction of screen
const float NIGHT_DIM = 0.30;   // how far the desktop dims in eclipse
const float GLASS     = 0.055;  // canopy vignette strength
const float EARTH_R   = 6371.0;
const float D2R       = 0.01745329252;
const int   STRIP_W   = 64;

// ------------------------------------------------------------ telemetry
// The strip lives at the top-left of the output, row 1. Row 0 is sacrificial
// and never read: a corner radius or a blur eats the top row first.
vec3 texel(int x) { return texelFetch(tex, ivec2(x, 1), 0).rgb; }

// 20 bits packed across R,G,B at 8/8/4 with the low nibble left-aligned in B.
float rawcode(int x) {
    vec3 t = texel(x);
    float r = floor(t.r * 255.0 + 0.5);
    float g = floor(t.g * 255.0 + 0.5);
    float b = floor(t.b * 255.0 + 0.5);
    return r * 4096.0 + g * 16.0 + floor(b / 16.0 + 0.5);
}
float gauge(int x, float lo, float hi) {
    return lo + (hi - lo) * (rawcode(x) / 1048575.0);
}
bool bitset(float flags, int bit) {
    float p = exp2(float(bit));
    return mod(floor(flags / p), 2.0) >= 1.0;
}

// ------------------------------------------------------------- orbit
// Fallback propagation: a circular orbit with J2 nodal regression. This is not
// SGP4 and does not pretend to be -- it is what keeps the panel honest when
// the daemon is down, and it is good to a few kilometres over the hours a
// compositor session lasts. When ritzpahd is up, the real state vector
// overwrites all of it.
vec3 propagate(float days) {
    float u    = (ISS_U0 + ISS_U_R * days) * D2R;
    float raan = (ISS_RAAN0 + ISS_RAAN_R * days) * D2R;
    float inc  = ISS_INC * D2R;
    float cu = cos(u), su = sin(u);
    float cr = cos(raan), sr = sin(raan);
    float ci = cos(inc), si = sin(inc);
    return ISS_A * vec3(cr * cu - sr * su * ci,
                        sr * cu + cr * su * ci,
                        su * si);
}

// Sun direction in the same J2000 frame, from its ecliptic longitude.
vec3 sun_dir(float days) {
    float lam = (SUNLON0 + SUNLON_R * days) * D2R;
    float e = EPS * D2R;
    return normalize(vec3(cos(lam), sin(lam) * cos(e), sin(lam) * sin(e)));
}

// Is the station in Earth's shadow? A cylinder, not a cone -- the penumbra is
// about ten seconds wide at this altitude and nothing here could show it.
float sunlit(vec3 pos, vec3 sun) {
    float along = dot(pos, sun);
    if (along > 0.0) return 1.0;
    float perp = length(pos - along * sun);
    // Softened over ~80 km so orbital sunrise is a sunrise and not a switch.
    return smoothstep(EARTH_R - 40.0, EARTH_R + 40.0, perp);
}

// ---------------------------------------------------------------- draw
float seg(vec2 p, vec2 a, vec2 b, float w) {
    vec2 pa = p - a, ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return smoothstep(w, w * 0.4, length(pa - ba * h));
}

// A needle gauge: an arc with a pointer, sweeping 210 to -30 degrees the way
// a real panel meter reads.
float dial(vec2 p, vec2 c, float r, float t) {
    float d = length(p - c);
    float a = atan(p.y - c.y, p.x - c.x);
    float lo = 210.0 * D2R, hi = -30.0 * D2R;
    float ring = smoothstep(r * 0.06, 0.0, abs(d - r)) * step(hi, a) * step(a, lo);
    float ang = mix(lo, hi, clamp(t, 0.0, 1.0));
    vec2 tip = c + r * 0.86 * vec2(cos(ang), sin(ang));
    return max(ring * 0.55, seg(p, c, tip, r * 0.045));
}

// A horizontal bar readout with a filled fraction.
float bar(vec2 p, vec2 c, vec2 hs, float t) {
    vec2 q = abs(p - c) - hs;
    float outline = smoothstep(0.0018, 0.0, abs(max(q.x, q.y)));
    float fw = hs.x * 2.0 * clamp(t, 0.0, 1.0);
    vec2 fc = vec2(c.x - hs.x + fw * 0.5, c.y);
    vec2 fq = abs(p - fc) - vec2(fw * 0.5, hs.y * 0.62);
    float fill = step(max(fq.x, fq.y), 0.0);
    return max(outline * 0.7, fill * 0.85);
}

// A round annunciator lamp. Lit lamps bloom; dark ones keep their bezel, so
// the panel reads the same whether or not anything is wrong.
vec3 lamp(vec2 p, vec2 c, float r, vec3 col, float on) {
    float d = length(p - c);
    float bezel = smoothstep(r, r * 0.82, d) - smoothstep(r * 0.78, r * 0.6, d);
    float face = smoothstep(r * 0.72, r * 0.5, d);
    float glow = exp(-d / (r * 1.6)) * on * 0.5;
    return col * (bezel * 0.35 + face * mix(0.06, 1.0, on) + glow);
}

void main() {
    vec2 uv = v_texcoord;
    vec2 res = resolution();
    float aspect = res.y > 1.0 ? res.x / res.y : 1.7778;
    vec2 p = vec2(uv.x * aspect, uv.y);

    vec3 scene = texture(tex, uv).rgb;

    // ------------------------------------------------------ read the strip
    float magic_a = rawcode(0);
    float magic_b = rawcode(1);
    bool have = abs(magic_a - 677292.0) < 1.0                // 0xA55AC
             && abs(floor(magic_b / 16.0) - 4096.0) < 1.0;   // schema 1

    float sum = 0.0;
    for (int i = 0; i < 63; i++) sum += rawcode(i);
    bool intact = have && abs(mod(sum, 1048576.0) - rawcode(63)) < 1.5;

    float flags = have ? rawcode(4) : 0.0;
    bool connected = have && bitset(flags, 0);
    bool fresh     = have && bitset(flags, 1);
    bool eva       = have && bitset(flags, 2);
    bool live      = intact && connected && fresh;

    // ------------------------------------------------------ orbital state
    float days = (time - T_LOAD) / 86400.0;
    vec3 pos = propagate(days);
    vec3 sun = sun_dir(days);
    float vel = 7660.0;

    if (live) {
        // The station overrules the model.
        pos = vec3(gauge(11, -8000.0, 8000.0),
                   gauge(12, -8000.0, 8000.0),
                   gauge(13, -8000.0, 8000.0));
        vel = length(vec3(gauge(14, -8000.0, 8000.0),
                          gauge(15, -8000.0, 8000.0),
                          gauge(16, -8000.0, 8000.0)));
    }

    float lit = sunlit(pos, sun);
    float radius = length(pos);
    float alt = radius - EARTH_R;

    // Subpoint. GMST turns the inertial frame into the one with countries on it.
    float gmst = (GMST0 + GMST_R * days) * D2R;
    float lat = asin(clamp(pos.z / max(radius, 1.0), -1.0, 1.0)) / D2R;
    float lon = (atan(pos.y, pos.x) - gmst) / D2R;
    lon = mod(lon + 180.0, 360.0) - 180.0;

    // ------------------------------------------------- the light outside
    // Forty-five minutes of sunlight, forty-five of night, and the desktop
    // lives in whichever one the station is actually in. This is the single
    // most load-bearing effect in the theme: the one you notice without
    // looking at an instrument.
    vec3 night_tint = C_BLUE * 0.16 + C_CYAN * 0.04;
    scene = mix(scene * (1.0 - NIGHT_DIM) + night_tint * 0.10, scene, lit);
    scene *= mix(0.82, 1.0, lit);

    // Sunrise catches the top of the frame first, because that is where the
    // limb is when you are coming out of the shadow.
    float sunrise = 1.0 - abs(lit * 2.0 - 1.0);
    scene += C_ORANGE * sunrise * 0.05 * smoothstep(0.55, 0.0, uv.y);

    // ------------------------------------------------------- the canopy
    vec2 cc = uv - 0.5;
    scene *= 1.0 - GLASS * dot(cc, cc) * 4.0;
    float glass = smoothstep(0.9, 0.0, abs(uv.x * 1.6 - uv.y - 0.35));
    scene += C_CYAN * glass * 0.012 * lit;

    // ------------------------------------------------- the instruments
    vec3 ink = vec3(0.0);
    float panel = smoothstep(PANEL_H, PANEL_H * 0.93, uv.y);
    if (panel > 0.001) {
        // The panel darkens what is behind it rather than replacing it: your
        // windows are still there, just under glass.
        scene *= mix(1.0, 0.34, panel);
        scene += C_ACCENT * panel * 0.012;

        float y = PANEL_H * 0.5;
        float r = PANEL_H * 0.34;

        float cabin_p  = live ? gauge(6, 0.0, 800.0)   : 750.0;
        float cabin_t  = live ? gauge(7, 0.0, 40.0)    : 22.5;
        float crewlock = live ? gauge(8, 0.0, 800.0)   : 750.0;
        float array_v  = live ? gauge(9, 0.0, 200.0)   : 160.0;
        float beta     = live ? gauge(10, -90.0, 90.0) : 0.0;

        ink += C_CYAN   * dial(p, vec2(0.055 * aspect, y), r, cabin_p / 800.0);
        ink += C_GREEN  * dial(p, vec2(0.115 * aspect, y), r, cabin_t / 40.0);
        ink += C_ORANGE * dial(p, vec2(0.175 * aspect, y), r, crewlock / 800.0);
        ink += C_ACCENT * dial(p, vec2(0.235 * aspect, y), r, array_v / 200.0);

        // Beta angle: how far the orbit plane is tilted out of the terminator,
        // which is what decides whether there is an eclipse at all.
        ink += C_BLUE * bar(p, vec2(0.35 * aspect, y),
                            vec2(0.05 * aspect, PANEL_H * 0.12),
                            (beta + 90.0) / 180.0);
        // Altitude and speed as bars, because a needle would imply a precision
        // the fallback propagation does not have.
        ink += C_FG * bar(p, vec2(0.35 * aspect, y - PANEL_H * 0.26),
                          vec2(0.05 * aspect, PANEL_H * 0.09),
                          (alt - 300.0) / 200.0);
        ink += C_MUTED * bar(p, vec2(0.35 * aspect, y + PANEL_H * 0.26),
                             vec2(0.05 * aspect, PANEL_H * 0.09),
                             (vel - 7000.0) / 1500.0);

        // Ground track. A world strip with the subpoint on it, so there is
        // always one instrument that says where you physically are.
        vec2 mc = vec2(0.60 * aspect, y);
        vec2 mh = vec2(0.13 * aspect, PANEL_H * 0.34);
        vec2 mq = abs(p - mc) - mh;
        ink += C_MUTED * smoothstep(0.0018, 0.0, abs(max(mq.x, mq.y))) * 0.5;
        if (max(mq.x, mq.y) < 0.0) {
            ink += C_MUTED * smoothstep(0.0016, 0.0, abs(p.y - mc.y)) * 0.35;
            float trop = mh.y * (23.4 / 90.0);
            ink += C_MUTED * smoothstep(0.0012, 0.0, abs(abs(p.y - mc.y) - trop)) * 0.2;
            vec2 dot_p = mc + vec2(mh.x * lon / 180.0, mh.y * lat / 90.0);
            float dd = length(p - dot_p);
            ink += mix(C_ORANGE, C_ACCENT, lit)
                 * (smoothstep(0.0045, 0.0, dd) + exp(-dd / 0.012) * 0.45);
        }

        // Annunciators. The row that tells you whether to believe the rest.
        float lr = PANEL_H * 0.16;
        vec2 lp = vec2(0.80 * aspect, y);
        ink += lamp(p, lp,                             lr, C_GREEN,  live ? 1.0 : 0.0);
        ink += lamp(p, lp + vec2(0.045 * aspect, 0.0), lr, C_ORANGE, live ? 0.0 : 1.0);
        ink += lamp(p, lp + vec2(0.090 * aspect, 0.0), lr, C_RED,    eva ? 1.0 : 0.0);
        // Signal: the feed's own acquisition-of-signal state. The station
        // really does lose the ground over the Indian Ocean, and that is not
        // the same thing as the daemon being broken.
        float sig = live ? gauge(25, 0.0, 3.0) : 0.0;
        ink += lamp(p, lp + vec2(0.135 * aspect, 0.0), lr, C_BLUE, step(2.5, sig));
    }

    // A hairline where the panel meets the sky.
    ink += C_ACCENT * smoothstep(0.0016, 0.0, abs(uv.y - PANEL_H)) * 0.5;

    scene += ink * mix(0.55, 1.0, lit);

    // ------------------------------------------------------- cover tracks
    // Paint over the telemetry strip. Hyprland's screencopy runs after this
    // shader, so the pixels the daemon wrote never reach the screen or a
    // screenshot -- they exist only in the frame this shader is reading.
    vec2 px = uv * res;
    if (px.x < float(STRIP_W) + 1.0 && px.y < 3.0) scene = vec3(0.0);

    fragColor = vec4(scene, 1.0);
}
