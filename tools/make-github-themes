# --- the mapping ------------------------------------------------------------
#
# The whole theme is this table. Left column is Ritzpah's slot, right column is
# the Primer token it is taken from, and the third is why that pairing is the
# honest one rather than merely a convenient one.

SURFACES = [
    ("background", "--bgColor-default",
     "the canvas every GitHub page is painted on"),
    ("dark_background", "--bgColor-inset",
     "recessed panels -- wells, sunken diff gutters, the bar"),
    ("darker_background", "--bgColor-black",
