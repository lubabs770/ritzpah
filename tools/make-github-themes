#!/usr/bin/env python3
"""Derive the five GitHub dark themes from Primer's published design tokens.

GitHub does not have a dark theme. It has five, and the differences between
them are not decorative -- dimmed lifts the whole canvas off black, high
contrast drives it to pure #010409/#ffffff, and the two accessibility variants
re-point the red/green axis that diff views lean on. Typing five palettes by
hand would mean typing a hundred and twenty-five hex values by hand, and the
one thing this repo has learned the hard way is that a hand-typed number is a
number that is eventually wrong.

So none of them are typed. This script fetches @primer/primitives at a pinned
version, resolves the CSS custom properties for each dark variant, and maps
them onto Ritzpah's slots. Every value in every generated colors.toml carries
the token it came from in a comment beside it. If you disagree with a colour,
you do not edit the toml -- you edit the mapping here, or you take it up with
Primer.

Usage:
    tools/make-github-themes                 # all five, into themes/
    tools/make-github-themes --check         # regenerate to memory, diff only
"""

import argparse
import json
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import primer  # noqa: E402

PRIMITIVES_VERSION = primer.VERSION

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# --- the five ---------------------------------------------------------------
#
# These are the dark modes GitHub actually offers you in Appearance settings.
