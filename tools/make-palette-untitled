#!/usr/bin/env bash
#
# Regenerate Untitled's colors.toml.
#
#   tools/make-palette-untitled [output-file]
#
# Prints to stdout with no argument. Nothing here is a design choice you can
# argue with: the eight hues are the canonical vivid sRGB primaries and
# secondaries, they are ranked by Rec.709 luma, and the ranks are dealt onto an
# evenly spaced band of neutral grays. Hue is discarded. Only the ordering
# survives.
#
# The band's floor (#7c7c7c) is the lightest gray that still fails to be
# comfortable and the darkest that hits 4.5:1 contrast against the #121212
# background -- i.e. it is picked by WCAG, not by taste. The ceiling (#d4d4d4)
# leaves room for the six bright variants at +22.

set -euo pipefail

OUT="${1:-/dev/stdout}"

# name:hex -- the reference hues, before anything is done to them.
HUES="red:ff0000 orange:ff8000 yellow:ffff00 green:00ff00 cyan:00ffff blue:0000ff magenta:ff00ff brown:a52a2a"

LO=124   # 4.5:1 on #121212
HI=212   # +22 for the brights still lands under #ffffff

# Rank by luma, then deal onto the band.
mapfile -t RANKED < <(
  for pair in $HUES; do
    name=${pair%%:*}; hex=${pair##*:}
    r=$((16#${hex:0:2})); g=$((16#${hex:2:2})); b=$((16#${hex:4:2}))
    luma=$(awk -v r="$r" -v g="$g" -v b="$b" 'BEGIN{printf "%09.4f", 0.2126*r + 0.7152*g + 0.0722*b}')
    echo "$luma $name $hex"
  done | sort -n
)

declare -A GRAY LUMA SRC
n=${#RANKED[@]}
for i in "${!RANKED[@]}"; do
  read -r luma name hex <<<"${RANKED[$i]}"
  v=$(awk -v i="$i" -v n="$n" -v lo="$LO" -v hi="$HI" 'BEGIN{printf "%d", lo + (hi-lo)*i/(n-1) + 0.5}')
  GRAY[$name]=$(printf '#%02x%02x%02x' "$v" "$v" "$v")
  LUMA[$name]=$(awk -v l="$luma" 'BEGIN{printf "%.3f", l/255}')
  SRC[$name]="#$hex"
done

bright() { # $1=name -- the normal gray, 22 lighter, clamped
  local v=$((16#$(printf '%s' "${GRAY[$1]}" | cut -c2-3) + 22))
  (( v > 255 )) && v=255
  printf '#%02x%02x%02x' "$v" "$v" "$v"
}

row() { printf '%-16s = "%s"  # was %s, luma %s\n' "$1" "${GRAY[$1]}" "${SRC[$1]}" "${LUMA[$1]}"; }

{
cat <<'HEADER'
# Untitled - generated by tools/make-palette-untitled. Do not hand-tune;
# hand-tuning would be a theme.
mode = "dark"

# The accent is the midpoint of the band. It accents nothing.
accent = "#8a8a8a"
selection = "#2e2e2e"
muted = "#5a5a5a"

background = "#121212"
dark_background = "#0c0c0c"
darker_background = "#000000"
lighter_background = "#1c1c1c"

foreground = "#c8c8c8"
# dark_foreground sits exactly on the 4.5:1 floor. Comments are as dim as
# they are allowed to be and not one step dimmer.
dark_foreground = "#7c7c7c"
light_foreground = "#dcdcdc"
bright_foreground = "#ffffff"

# Eight hues, ranked by Rec.709 luma, dealt onto an even gray band.
HEADER

for name in red yellow orange green cyan blue magenta brown; do row "$name"; done

echo
echo "# Bright variants: the same gray, 22 lighter. No other difference exists."
for name in red yellow green cyan blue magenta; do
  printf '%-16s = "%s"\n' "bright_$name" "$(bright "$name")"
done

cat <<'FOOTER'

# One color, one stop, no angle. A gradient would be a point of view.
hyprland_active_border = "rgba(5a5a5aff)"
hyprland_inactive_border = "rgba(262626ff)"
FOOTER
} > "$OUT"
