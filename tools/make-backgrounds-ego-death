#!/usr/bin/env bash
#
# Regenerate the Ego Death wallpaper set with ImageMagick.
#
#   tools/make-backgrounds-ego-death [output-dir] [width] [height]
#
# Defaults to themes/ego-death/backgrounds at 2560x1440. Where Acid Vortex maps
# a clean field through narrow neon bands, this one domain-warps plasma with
# more plasma and maps the result through the full spectrum twice over, so no
# region settles into a single colour or a stable shape.

set -euo pipefail

OUT="${1:-$(dirname "$0")/../themes/ego-death/backgrounds}"
W="${2:-2560}"
H="${3:-1440}"

command -v magick >/dev/null || { echo "ImageMagick 7 (magick) is required" >&2; exit 1; }

mkdir -p "$OUT"
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

# Two trips around the colour wheel, cut with dark bands so the spectrum reads
# as ribbons instead of mush.
magick \
  \( -size 1x22 gradient:'#ff0000-#ff9900' \) \( -size 1x21 gradient:'#ff9900-#ffee00' \) \
  \( -size 1x21 gradient:'#ffee00-#00ff44' \) \( -size 1x22 gradient:'#00ff44-#00ffee' \) \
  \( -size 1x21 gradient:'#00ffee-#0066ff' \) \( -size 1x21 gradient:'#0066ff-#aa00ff' \) \
  \( -size 1x22 gradient:'#aa00ff-#ff00aa' \) \( -size 1x22 gradient:'#ff00aa-#ff0000' \) \
  \( -size 1x21 gradient:'#ff0000-#ffee00' \) \( -size 1x21 gradient:'#ffee00-#00ffee' \) \
  \( -size 1x21 gradient:'#00ffee-#aa00ff' \) \( -size 1x21 gradient:'#aa00ff-#ff0000' \) \
  -append -rotate 90 "$TMP/rainbow.png"
magick -size 256x1 gradient:white-black -colorspace Gray \
  -function Sinusoid 7,90,0.62,0.38 "$TMP/bands.png"
magick "$TMP/rainbow.png" "$TMP/bands.png" -compose multiply -composite "$TMP/clut.png"

# Displacement map: a second plasma field, used to drag the first one around.
warpmap() { magick -size "${W}x${H}" plasma:fractal -colorspace Gray -blur 0x6 -auto-level "$1"; }

# Grayscale field -> spectrum -> bloom, contrast. No vignette: the edges are
# meant to keep going.
paint() { # $1=gray in  $2=jpg out
  magick "$1" -type TrueColor "$TMP/clut.png" -interpolate bilinear -clut "$TMP/painted.png"
  magick "$TMP/painted.png" \( +clone -blur 0x22 \) -compose screen -composite \
    -brightness-contrast -10x18 -modulate 100,140,100 \
    -quality 93 "$2"
}

echo "1-dissolve"
magick -size "${W}x${H}" plasma:fractal -colorspace Gray -auto-level -blur 0x2 "$TMP/a.png"
warpmap "$TMP/m.png"
magick "$TMP/a.png" "$TMP/m.png" -compose displace \
  -define compose:args=90x90 -composite -swirl 160 "$TMP/g.png"
paint "$TMP/g.png" "$OUT/1-dissolve.jpg"

echo "2-oil-slick"
magick -size "${W}x${H}" plasma:fractal -colorspace Gray -auto-level \
  -blur 0x4 -swirl 620 -implode -0.5 "$TMP/a.png"
warpmap "$TMP/m.png"
magick "$TMP/a.png" "$TMP/m.png" -compose displace \
  -define compose:args=60x60 -composite "$TMP/g.png"
paint "$TMP/g.png" "$OUT/2-oil-slick.jpg"

# Six-fold rotational symmetry: a shape that reads as a shape until you look
# at any part of it.
echo "3-mandala"
magick -size 1600x1600 plasma:fractal -colorspace Gray -auto-level -blur 0x3 \
  -swirl 400 "$TMP/a.png"
# Mirror virtual-pixel keeps the rotated copies edge-to-edge, so the stack has
# no transparent corners to flatten into hard geometry. Averaging the three
# rotations (rather than lighten, which just saturates to white) leaves a soft
# three-fold field that auto-level can stretch back out.
magick "$TMP/a.png" -virtual-pixel Mirror \
  \( +clone -distort SRT 60 \) \( +clone -distort SRT 120 \) \
  -evaluate-sequence mean -auto-level -blur 0x2 \
  -gravity center -crop 1100x1100+0+0 +repage "$TMP/s.png"
magick \( "$TMP/s.png" \( +clone -flop \) +append \) \( +clone -flip \) -append \
  -resize "${W}x${H}^" -gravity center -crop "${W}x${H}+0+0" +repage "$TMP/g.png"
paint "$TMP/g.png" "$OUT/3-mandala.jpg"

echo "4-mercury"
magick -size "${W}x${H}" plasma:fractal -colorspace Gray -auto-level \
  -blur 0x3 -shade 120x30 -auto-level -blur 0x5 -swirl 240 "$TMP/a.png"
warpmap "$TMP/m.png"
magick "$TMP/a.png" "$TMP/m.png" -compose displace \
  -define compose:args=45x45 -composite -blur 0x1 "$TMP/g.png"
paint "$TMP/g.png" "$OUT/4-mercury.jpg"

echo "5-event-horizon"
magick -size 3400x3400 radial-gradient:white-black -colorspace Gray \
  -function Sinusoid 5,0 -implode 1.2 -swirl 420 \
  -gravity center -crop "${W}x${H}+0+0" +repage "$TMP/a.png"
warpmap "$TMP/m.png"
magick "$TMP/a.png" "$TMP/m.png" -compose displace \
  -define compose:args=110x110 -composite "$TMP/g.png"
paint "$TMP/g.png" "$OUT/5-event-horizon.jpg"

echo "wrote 5 backgrounds to $OUT"
