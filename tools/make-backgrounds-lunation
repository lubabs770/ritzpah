#!/usr/bin/env python3
"""Wallpapers for the Lunation theme.

Every Moon on every plate here is computed, not drawn and not photographed.
The same reflectance model the screen shader uses -- Lommel-Seeliger scattering
off a rough regolith, an opposition surge at small phase angles, twenty-four
mare basins and four rayed craters as unit vectors on a sphere -- is evaluated
in Python instead of GLSL, and the same truncated Meeus ephemeris decides what
phase, what distance and what libration each of them is at.

That means two things worth knowing before you run it:

  * The plates are dated. `1-lunation` is the synodic month that CONTAINS the
    day you generate it, and `2-transit` is a real night at your real latitude.
    Run it in June and run it again in December and you get different skies,
    because they were different skies. The recipe is the deliverable; a
    particular set of images never was.
  * It is slow, and it is slow on the CPU, on purpose. Roughly ten million
    lunar surface points get their own incidence angle. Ninety seconds.

Needs: python3 (standard library only) and ImageMagick 7 for the compositing.
Reaches the network: never.

    tools/make-backgrounds-lunation [out-dir] [width] [height]
"""

import math
import os
import shutil
import subprocess
import sys
import tempfile
import time

D2R = math.pi / 180.0

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(HERE)
OUT = sys.argv[1] if len(sys.argv) > 1 else os.path.join(REPO, "themes/lunation/backgrounds")
W = int(sys.argv[2]) if len(sys.argv) > 2 else 2560
H = int(sys.argv[3]) if len(sys.argv) > 3 else 1440

MAGICK = shutil.which("magick")
if not MAGICK:
    sys.exit("make-backgrounds-lunation: needs ImageMagick 7 (`magick`), which is not on PATH")


# ----------------------------------------------------------------- palette
BG = "#05070e"
INK = "#d9dee8"
FAINT = "#1e2a44"
ASH = (0.62, 0.70, 0.92)
TINT = (1.000, 0.972, 0.926)


def sd(x): return math.sin(x * D2R)
def cd(x): return math.cos(x * D2R)
def wrap(x): return x - 360.0 * math.floor(x / 360.0)
def clamp(x, a, b): return a if x < a else (b if x > b else x)


def smoothstep(e0, e1, x):
    t = clamp((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


# ------------------------------------------------------------- the surface
# lon (east positive), lat, angular radius in degrees. Radii are the real
# diameters over the real lunar radius, which is why Imbrium is a third of the
# way across the face and Sinus Medii is a freckle.
MARE = [
    (-52.0, 40.0, 13.0), (-57.4, 18.4, 15.5), (-55.0, -1.0, 14.0), (-46.0, -15.0, 10.0),
    (-15.6, 32.8, 18.9), (17.5, 28.0, 11.7), (31.4, 8.5, 14.4), (59.1, 17.0, 9.2),
    (51.3, -7.8, 15.0), (34.6, -15.2, 5.5), (-16.6, -21.3, 11.8), (-38.6, -24.4, 6.4),
    (-23.1, -10.0, 5.8), (-30.9, 7.5, 8.4), (3.6, 13.3, 4.0), (-40.0, 57.0, 4.5),
    (-16.0, 58.0, 4.5), (10.0, 56.0, 4.5), (87.0, 1.3, 6.2), (93.0, -38.9, 10.0),
    (-8.8, 10.9, 3.5), (0.0, 0.0, 2.3), (0.4, 26.5, 3.0), (86.1, 13.3, 5.0),
]
RAYED = [(-11.4, -43.3, 2.8), (-20.1, 9.6, 2.6), (-38.0, 8.1, 1.1), (-47.4, 23.7, 1.3)]


def unit(lon, lat, radius):
    la, lo = lat * D2R, lon * D2R
    return (math.cos(la) * math.sin(lo), math.sin(la), math.cos(la) * math.cos(lo),
            math.cos(radius * D2R))


MARE_V = [unit(*m) for m in MARE]
RAYED_V = [unit(*r) for r in RAYED]
TYCHO = RAYED_V[0][:3]
_e = (TYCHO[2], 0.0, -TYCHO[0])
_el = math.hypot(_e[0], _e[2]) or 1.0
EAST = (_e[0] / _el, 0.0, _e[2] / _el)
NORTH = (TYCHO[1] * EAST[2] - TYCHO[2] * EAST[1],
         TYCHO[2] * EAST[0] - TYCHO[0] * EAST[2],
         TYCHO[0] * EAST[1] - TYCHO[1] * EAST[0])


def disc(size, phase, limb, lib_lon=0.0, lib_lat=0.0, tilt=0.0, earthshine=True):
    """One Moon, `size` pixels across, as (rgb bytes, alpha bytes).

    phase  -- phase angle in degrees: 0 is full, 180 is new.
    limb   -- screen direction of the Sun, degrees clockwise from up.
    tilt   -- how far the north pole is rolled off vertical, degrees.
    """
    k = 0.5 * (1.0 + cd(phase))
    sdx, sdy = sd(limb), cd(limb)
    ci, si = cd(phase), sd(phase)
    ct, st = cd(tilt), sd(tilt)
    clb, slb = cd(lib_lat), sd(lib_lat)
    cll, sll = cd(lib_lon), sd(lib_lon)
    surge = 1.0 + 0.40 * math.exp(-phase / 7.0)

    rgb = bytearray(size * size * 3)
    alpha = bytearray(size * size)
    half = size / 2.0
    for py in range(size):
        ny = -((py + 0.5) - half) / half
        for px in range(size):
            nx = ((px + 0.5) - half) / half
            rr = nx * nx + ny * ny
            if rr > 1.0:
                continue
            w = math.sqrt(1.0 - rr)
            a = nx * sdx + ny * sdy
            mu0 = a * si + w * ci
            rx, ry = nx * ct + ny * st, -nx * st + ny * ct
            tx, ty, tz = rx, ry * clb + w * slb, -ry * slb + w * clb
            gx, gy, gz = tx * cll + tz * sll, ty, -tx * sll + tz * cll

            wob = (0.006 * math.sin(9.0 * gx + 3.0 * gy) * math.cos(7.0 * gz - 2.0 * gx)
                   + 0.003 * math.sin(17.0 * gy - 5.0 * gz))
            basalt = 0.0
            for mx, my, mz, mw in MARE_V:
                c = gx * mx + gy * my + gz * mz + wob
                if c > mw:
                    basalt = max(basalt, smoothstep(mw, mw + (1.0 - mw) * 0.40, c))
            albedo = 1.0 + (0.50 - 1.0) * basalt
            for bx, by, bz, bw in RAYED_V:
                c = gx * bx + gy * by + gz * bz
                if c > bw:
                    albedo += 0.24 * smoothstep(bw, bw + (1.0 - bw) * 0.55, c)
            cT = gx * TYCHO[0] + gy * TYCHO[1] + gz * TYCHO[2]
            if cT > 0.62:
                theta = math.atan2(gx * NORTH[0] + gy * NORTH[1] + gz * NORTH[2],
                                   gx * EAST[0] + gy * EAST[1] + gz * EAST[2])
                reach = smoothstep(0.62, 0.995, cT)
                albedo += 0.11 * reach * (0.5 + 0.5 * math.cos(theta * 11.0))
            albedo = clamp(albedo, 0.30, 1.60)

            shade = (mu0 / max(mu0 + w, 1e-3)) * surge if mu0 > 0.0 else 0.0
            ash = albedo * (1.0 - k) * 0.075 * (w ** 0.35) if earthshine else 0.0
            i = (py * size + px) * 3
            for c in range(3):
                v = TINT[c] * albedo * shade + ASH[c] * ash
                rgb[i + c] = int(clamp(v, 0.0, 1.0) * 255.0 + 0.5)
            edge = 1.0 - smoothstep(0.985, 1.0, math.sqrt(rr))
            alpha[py * size + px] = int(edge * 255.0 + 0.5)
    return bytes(rgb), bytes(alpha)


# ------------------------------------------------------------- ephemeris
# The same twenty-term truncation of Meeus 47 that hyprland.lua carries, in
# Python. Three implementations of one model in three languages is a lot of
# duplication, and every one of them is checked against Meeus's worked example
# 47.a before it is allowed to draw anything.
def arguments(T):
    return dict(
        Lp=218.3164477 + 481267.88123421 * T - 0.0015786 * T * T,
        D=297.8501921 + 445267.1114034 * T - 0.0018819 * T * T,
        Ms=357.5291092 + 35999.0502909 * T - 0.0001536 * T * T,
        Mp=134.9633964 + 477198.8675055 * T + 0.0087414 * T * T,
        F=93.2720950 + 483202.0175233 * T - 0.0036539 * T * T,
        Om=125.0445479 - 1934.1362891 * T,
        L0=280.46646 + 36000.76983 * T + 0.0003032 * T * T)


def ephemeris(jd, lat=None, lon=None):
    T = (jd - 2451545.0) / 36525.0
    a = arguments(T)
    D, Ms, Mp, F = a["D"], a["Ms"], a["Mp"], a["F"]
    lam = (a["Lp"] + 6.288774 * sd(Mp) + 1.274027 * sd(2*D - Mp) + 0.658314 * sd(2*D)
           + 0.213618 * sd(2*Mp) - 0.185116 * sd(Ms) - 0.114332 * sd(2*F)
           + 0.058793 * sd(2*D - 2*Mp) + 0.057066 * sd(2*D - Ms - Mp)
           + 0.053322 * sd(2*D + Mp) + 0.045758 * sd(2*D - Ms) - 0.040923 * sd(Ms - Mp)
           - 0.034720 * sd(D) - 0.030383 * sd(Ms + Mp) + 0.015327 * sd(2*D - 2*F)
           - 0.012528 * sd(Mp + 2*F) + 0.010980 * sd(Mp - 2*F) + 0.010675 * sd(4*D - Mp)
           + 0.010034 * sd(3*Mp) + 0.008548 * sd(4*D - 2*Mp))
    bet = (5.128122 * sd(F) + 0.280602 * sd(Mp + F) + 0.277693 * sd(Mp - F)
           + 0.173237 * sd(2*D - F) + 0.055413 * sd(2*D - Mp + F)
           + 0.046271 * sd(2*D - Mp - F) + 0.032573 * sd(2*D + F)
           + 0.017198 * sd(2*Mp + F) + 0.009266 * sd(2*D + Mp - F)
           + 0.008822 * sd(2*Mp - F) + 0.008216 * sd(2*D - Ms - F))
    dist = (385000.56 - 20905.355 * cd(Mp) - 3699.111 * cd(2*D - Mp) - 2955.968 * cd(2*D)
            - 569.925 * cd(2*Mp) + 48.888 * cd(Ms) - 3.149 * cd(2*F)
            + 246.158 * cd(2*D - 2*Mp) - 152.138 * cd(2*D - Ms - Mp)
            - 170.733 * cd(2*D + Mp) - 204.586 * cd(2*D - Ms) - 129.620 * cd(Ms - Mp)
            + 108.743 * cd(D) + 104.755 * cd(Ms + Mp) + 79.661 * cd(Mp - 2*F))
    C = 1.914602 * sd(Ms) + 0.019993 * sd(2*Ms) + 0.000289 * sd(3*Ms)
    slam = wrap(a["L0"] + C)
    e = 0.016708634
    rsun = 1.000001018 * (1 - e * e) / (1 + e * cd(Ms + C)) * 149597870.7
    eps = 23.439291 - 0.0130042 * T

    elong = math.degrees(math.acos(clamp(cd(bet) * cd(wrap(lam) - slam), -1, 1)))
    phase = math.degrees(math.atan2(rsun * sd(elong), dist - rsun * cd(elong)))

    Wv = (wrap(lam) - a["Om"]) * D2R
    I = 1.54242 * D2R
    bR = bet * D2R
    A = math.atan2(math.sin(Wv) * math.cos(bR) * math.cos(I) - math.sin(bR) * math.sin(I),
                   math.cos(Wv) * math.cos(bR))
    lib_lon = wrap(math.degrees(A) - F + 180.0) - 180.0
    lib_lat = math.degrees(math.asin(clamp(
        -math.sin(Wv) * math.cos(bR) * math.sin(I) - math.sin(bR) * math.cos(I), -1, 1)))

    out = dict(lam=wrap(lam), bet=bet, dist=dist, slam=slam, phase=phase,
               k=0.5 * (1 + cd(phase)), lib_lon=lib_lon, lib_lat=lib_lat,
               waxing=wrap(wrap(lam) - slam) < 180.0)

    def eq(l, b):
        sl, cl, sb, cb = sd(l), cd(l), sd(b), cd(b)
        se, ce = sd(eps), cd(eps)
        return (wrap(math.degrees(math.atan2(sl * ce - (sb / cb) * se, cl))),
                math.degrees(math.asin(clamp(sb * ce + cb * se * sl, -1, 1))))

    out["ra"], out["dec"] = eq(wrap(lam), bet)
    out["sra"], out["sdec"] = eq(slam, 0.0)
    if lat is not None:
        d = jd - 2451545.0
        gmst = wrap(280.46061837 + 360.98564736629 * d + 0.000387933 * T * T)
        lst = gmst + lon

        def horiz(ra, dec):
            Hh = lst - ra
            sH, cH, sD, cD = sd(Hh), cd(Hh), sd(dec), cd(dec)
            alt = math.degrees(math.asin(clamp(sD * sd(lat) + cD * cd(lat) * cH, -1, 1)))
            azS = math.degrees(math.atan2(sH * cD, cH * sd(lat) * cD - sD * cd(lat)))
            return alt, wrap(azS + 180.0), Hh

        out["alt"], out["az"], Hh = horiz(out["ra"], out["dec"])
        out["salt"], out["saz"], _ = horiz(out["sra"], out["sdec"])
        out["q"] = math.degrees(math.atan2(
            sd(Hh), math.tan(lat * D2R) * cd(out["dec"]) - sd(out["dec"]) * cd(Hh)))
    return out


def jd_now():
    return time.time() / 86400.0 + 2440587.5


def observer():
    """Same fallback chain the theme uses, minus the zoneinfo byte-matching:
    a generator may use a subprocess, so this one can simply ask."""
    zone = os.environ.get("TZ") or ""
    if not zone:
        link = "/etc/localtime"
        if os.path.islink(link):
            zone = os.path.realpath(link).split("zoneinfo/")[-1]
    try:
        with open("/usr/share/zoneinfo/zone1970.tab", encoding="utf-8") as fh:
            for line in fh:
                if line.startswith("#"):
                    continue
                cols = line.rstrip("\n").split("\t")
                if len(cols) < 3 or zone not in cols[2].split(","):
                    continue
                c = cols[1]
                sign = 1 if c[0] == "+" else -1
                lat = sign * (int(c[1:3]) + int(c[3:5]) / 60 + (int(c[5:7]) / 3600 if len(c) > 11 else 0))
                rest = c[7:] if len(c) > 11 else c[5:]
                lsign = 1 if rest[0] == "+" else -1
                lon = lsign * (int(rest[1:4]) + int(rest[4:6]) / 60 + (int(rest[6:8]) / 3600 if len(rest) > 7 else 0))
                return lat, lon, zone
    except OSError:
        pass
    return 51.4779, -0.0015, "Greenwich"


# ------------------------------------------------------------- plumbing
TMP = tempfile.mkdtemp(prefix="lunation-")


def png_of_disc(name, size, **kw):
    """Render a Moon and hand ImageMagick a PNG with a real alpha channel."""
    rgb, alpha = disc(size, **kw)
    rgb_path = os.path.join(TMP, name + ".rgb.ppm")
    a_path = os.path.join(TMP, name + ".a.pgm")
    out = os.path.join(TMP, name + ".png")
    with open(rgb_path, "wb") as fh:
        fh.write(b"P6\n%d %d\n255\n" % (size, size))
        fh.write(rgb)
    with open(a_path, "wb") as fh:
        fh.write(b"P5\n%d %d\n255\n" % (size, size))
        fh.write(alpha)
    run([MAGICK, rgb_path, a_path, "-alpha", "off", "-compose", "copy-opacity",
         "-composite", out])
    return out


def run(cmd):
    subprocess.run(cmd, check=True)


FONT = None


def font_args():
    """Pick a mono font by trying to draw with it. `magick -list font` will
    cheerfully name fonts it then cannot open, so asking is not the same as
    testing, and a plate whose caption silently failed to render is exactly the
    kind of thing that ships."""
    global FONT
    if FONT is None:
        FONT = ""
        probe = os.path.join(TMP, "font-probe.png")
        for want in ("JetBrainsMono-NF-Regular", "JetBrainsMono-Nerd-Font",
                     "DejaVuSansMono", "DejaVu-Sans-Mono", "Liberation-Mono",
                     "LiberationMono", "Courier"):
            try:
                subprocess.run([MAGICK, "-size", "80x20", "xc:black", "-font", want,
                                "-pointsize", "10", "-fill", "white",
                                "-annotate", "+2+12", "x", probe],
                               check=True, capture_output=True)
                FONT = want
                break
            except subprocess.CalledProcessError:
                continue
        if not FONT:
            print("  (no usable mono font found; plates will be captionless)")
    return ["-font", FONT] if FONT else []


def sky(path, glow_x=0.5, glow_y=1.05, stars=1.0):
    """A night sky: a vertical gradient, a wash of airglow somewhere off the
    plate, and a star field made by thresholding noise instead of by drawing
    dots -- which is why no two runs of this script produce the same stars.

    The glow is cut out of a canvas three times the size of the plate so that
    its centre can be put outside the frame, which is where the interesting
    places to put it are.
    """
    gw, gh = W * 3, H * 3
    ox = int(1.5 * W - glow_x * W)
    oy = int(1.5 * H - glow_y * H)
    run([MAGICK,
         "-size", "%dx%d" % (W, H), "gradient:#060a16-#010206",
         # Built at a quarter size and blown back up: it is a smooth gradient,
         # and rendering nine screens' worth of it at full resolution to then
         # throw eight of them away is not a good use of anybody's afternoon.
         "(", "-size", "%dx%d" % (gw // 4, gh // 4), "radial-gradient:#16305c-#000000",
         # A linear radial gradient across three screens is not a glow, it is a
         # uniform lift. Squaring it pulls the light back into a core.
         "-evaluate", "pow", "2.4",
         "-resize", "%dx%d!" % (gw, gh),
         "-crop", "%dx%d+%d+%d" % (W, H, ox, oy), "+repage", ")",
         "-compose", "screen", "-composite",
         "(", "-size", "%dx%d" % (W, H), "xc:", "+noise", "Random",
         "-channel", "R", "-separate", "+channel",
         "-black-threshold", "%.3f%%" % (100.0 - 0.14 * stars),
         "-level", "0%,2.4%",
         "-blur", "0x0.6", ")",
         "-compose", "screen", "-composite",
         "-attenuate", "0.35", "+noise", "Gaussian",
         path])


def finish(path, out_name):
    run([MAGICK, path, "-quality", "90", "-sampling-factor", "4:2:0",
         "-strip", os.path.join(OUT, out_name)])
    print("  ->", out_name)


# ------------------------------------------------------------- the plates
def plate_lunation(jd0):
    """One synodic month. Thirty discs, one per day, each at the phase,
    distance and libration it really has on that day."""
    print("1-lunation: thirty days, one disc each")
    cols, rows = 6, 5
    cell = min(W // cols, H // rows)
    size = int(cell * 0.62)
    # Start at the new Moon on or before today, so the grid opens on a new Moon.
    jd = jd0
    while ephemeris(jd)["phase"] < 176.0:
        jd -= 0.5
    base = os.path.join(TMP, "lun-bg.png")
    sky(base, glow_y=1.4, stars=0.7)
    args = [MAGICK, base]
    for i in range(cols * rows):
        e = ephemeris(jd + i * 0.9846)      # a synodic month, thirty even steps
        scale = 384400.0 / e["dist"]
        s = max(24, int(size * scale))
        limb = 270.0 if e["waxing"] else 90.0
        d = png_of_disc("lun%02d" % i, s, phase=e["phase"], limb=limb,
                        lib_lon=e["lib_lon"], lib_lat=e["lib_lat"])
        cx = int((i % cols + 0.5) * (W / cols) - s / 2)
        cy = int((i // cols + 0.5) * (H / rows) - s / 2)
        args += ["(", d, ")", "-geometry", "+%d+%d" % (cx, cy), "-compose", "over", "-composite"]
    args += ["-blur", "0x0.4"]
    args += font_args() + ["-pointsize", str(max(11, H // 90)), "-fill", "#5a6a8c",
                           "-gravity", "SouthEast", "-annotate", "+%d+%d" % (W // 40, H // 40),
                           "one synodic month  29.53 days  computed for %s" %
                           time.strftime("%Y-%m-%d", time.gmtime((jd - 2440587.5) * 86400))]
    out = os.path.join(TMP, "1.png")
    args.append(out)
    run(args)
    finish(out, "1-lunation.jpg")


def plate_transit(jd0, lat, lon, zone):
    """One night, at your latitude: the Moon where it really is, hour by hour,
    on the same projection the screen shader uses."""
    print("2-transit: one night's arc")
    base = os.path.join(TMP, "tr-bg.png")
    sky(base, glow_y=1.15, stars=1.0)
    az_center = 180.0 if lat >= 0 else 0.0

    # Find a night this month when the Moon is up and reasonably lit.
    best, best_score = jd0, -1
    for step in range(0, 30 * 24):
        j = jd0 + step / 24.0
        e = ephemeris(j, lat, lon)
        score = max(e["alt"], 0) * e["k"]
        if score > best_score:
            best, best_score = j, score
    args = [MAGICK, base]
    grid = []
    for alt in (0, 15, 30, 45, 60, 75):
        y = int(H * (0.06 + 0.80 * (1.0 - alt / 90.0)))
        grid += ["-stroke", "#16223c" if alt else "#2b3d63", "-strokewidth",
                 "2" if alt == 0 else "1", "-draw", "line 0,%d %d,%d" % (y, W, y)]
    for az in range(0, 360, 45):
        dx = (az - az_center + 540.0) % 360.0 - 180.0
        x = int(W * (0.5 + dx / 360.0))
        grid += ["-stroke", "#16223c", "-strokewidth", "1",
                 "-draw", "line %d,0 %d,%d" % (x, x, H)]
    args += grid + ["-stroke", "none"]

    hours = 9
    for i in range(hours):
        j = best + (i - hours // 2) / 16.0    # ninety minutes apart
        e = ephemeris(j, lat, lon)
        if e["alt"] < -4:
            continue
        s = int(H * 0.085 * (384400.0 / e["dist"]))
        # The bright limb points at the Sun, in the same projection.
        def proj(alt, az):
            dx = (az - az_center + 540.0) % 360.0 - 180.0
            return 0.5 + dx / 360.0, 0.06 + 0.80 * (1.0 - alt / 90.0)
        mx, my = proj(e["alt"], e["az"])
        sx, sy = proj(e["salt"], e["saz"])
        limb = math.degrees(math.atan2((sx - mx) * (W / H), -(sy - my)))
        d = png_of_disc("tr%02d" % i, s, phase=e["phase"], limb=limb, tilt=-e["q"],
                        lib_lon=e["lib_lon"], lib_lat=e["lib_lat"])
        args += ["(", d, ")", "-geometry", "+%d+%d" % (int(mx * W - s / 2), int(my * H - s / 2)),
                 "-compose", "over", "-composite"]
    label = "%s  %.2f, %.2f  altitude and azimuth, ninety minutes apart" % (
        zone, lat, lon)
    args += font_args() + ["-pointsize", str(max(11, H // 90)), "-fill", "#5a6a8c",
                           "-gravity", "SouthWest", "-annotate", "+%d+%d" % (W // 40, H // 40), label]
    out = os.path.join(TMP, "2.png")
    args.append(out)
    run(args)
    finish(out, "2-transit.jpg")


def plate_terminator():
    """The terminator, close enough that it is the only thing on the plate."""
    print("3-terminator: one very large crescent")
    s = int(H * 1.55)
    d = png_of_disc("term", s, phase=118.0, limb=250.0, lib_lon=-5.5, lib_lat=3.0, tilt=-14.0)
    base = os.path.join(TMP, "te-bg.png")
    sky(base, glow_x=0.15, glow_y=0.5, stars=1.3)
    out = os.path.join(TMP, "3.png")
    run([MAGICK, base, "(", d, ")",
         "-geometry", "+%d+%d" % (int(W * 0.46), int(-s * 0.24)),
         "-compose", "over", "-composite",
         # -geometry is a setting, not an argument: it stays set until it is
         # changed, and the bloom pass below would otherwise be composited at
         # whatever offset the Moon was placed with.
         "-geometry", "+0+0",
         "(", "+clone", "-blur", "0x28", "-evaluate", "multiply", "0.45", ")",
         "-compose", "screen", "-composite", out])
    finish(out, "3-terminator.jpg")


def plate_earthshine():
    """The old Moon in the new Moon's arms. Almost nothing, on purpose: the
    ashen light is two hundred and fifty times fainter than the sunlit limb,
    and a plate that shows it honestly is a plate that is nearly black."""
    print("4-earthshine: the ashen light")
    s = int(H * 0.62)
    d = png_of_disc("ash", s, phase=147.0, limb=205.0, lib_lon=6.0, lib_lat=-4.0, tilt=22.0)
    base = os.path.join(TMP, "es-bg.png")
    sky(base, glow_x=0.30, glow_y=1.02, stars=1.5)
    out = os.path.join(TMP, "4.png")
    run([MAGICK, base, "(", d, ")",
         "-geometry", "+%d+%d" % (int(W * 0.30 - s / 2), int(H * 0.42 - s / 2)),
         "-compose", "over", "-composite",
         "-geometry", "+0+0",
         "(", "+clone", "-blur", "0x40", "-evaluate", "multiply", "0.38", ")",
         "-compose", "screen", "-composite",
         "-modulate", "98,104,100", out])
    finish(out, "4-earthshine.jpg")


def plate_libration(jd0):
    """Nine full Moons over one month, showing the nod. The Moon keeps one face
    turned toward us and then cheats by about eight degrees in each direction,
    which is how we have ever seen fifty-nine percent of a body that is
    supposedly locked."""
    print("5-libration: the nod")
    cols, rows = 3, 2
    size = int(min(W / cols, H / rows) * 0.70)
    base = os.path.join(TMP, "li-bg.png")
    sky(base, glow_y=0.5, stars=0.5)
    args = [MAGICK, base]
    picks = []
    for step in range(0, int(27.32 * 8)):
        j = jd0 + step / 8.0
        e = ephemeris(j)
        picks.append((j, e))
    picks.sort(key=lambda p: (p[1]["lib_lon"], p[1]["lib_lat"]))
    chosen = [picks[int(i * (len(picks) - 1) / 5.0)] for i in range(6)]
    chosen.sort(key=lambda p: p[0])
    for i, (j, e) in enumerate(chosen):
        d = png_of_disc("li%d" % i, size, phase=6.0, limb=270.0,
                        lib_lon=e["lib_lon"], lib_lat=e["lib_lat"])
        cx = int((i % cols + 0.5) * (W / cols) - size / 2)
        cy = int((i // cols + 0.5) * (H / rows) - size / 2)
        args += ["(", d, ")", "-geometry", "+%d+%d" % (cx, cy), "-compose", "over", "-composite"]
    args += font_args() + ["-pointsize", str(max(11, H // 90)), "-fill", "#5a6a8c",
                           "-gravity", "South", "-annotate", "+0+%d" % (H // 40),
                           "optical libration, one month, +-8 degrees in longitude and latitude"]
    # Six full Moons at their real brightness is a plate you cannot put an icon
    # on. This is the one exposure decision on any of these plates, and it is
    # the whole plate rather than the Moons, so nothing gets misrepresented
    # relative to anything else.
    args += ["-evaluate", "multiply", "0.80"]
    out = os.path.join(TMP, "5.png")
    args.append(out)
    run(args)
    finish(out, "5-libration.jpg")


def preview(jd0, lat, lon):
    """themes/lunation/preview.png -- a mock desktop, rendered, never captured.

    Faithful in the one way that matters: the Moon goes on LAST, with a screen
    blend, which is arithmetically what the shader does to the finished frame.
    It adds light where the frame is dark and leaves lit pixels alone, so it
    pours over the wallpaper and over the dark insides of the cards and does
    nothing whatsoever to the text on top of them.
    """
    print("preview.png: a desktop that does not exist")
    global W, H
    keep = (W, H)
    W, H = 1800, 1012

    # A preview of a night theme should be at night, with the Moon high enough
    # to be in the empty part of the frame. Wind forward until it is.
    jd, best = jd0, -1.0
    for step in range(0, 40 * 24):
        j = jd0 + step / 24.0
        c = ephemeris(j, lat, lon)
        score = max(c["alt"], 0.0) * c["k"]
        if score > best:
            jd, best = j, score
    e = ephemeris(jd, lat, lon)
    az_center = 180.0 if lat >= 0 else 0.0

    def proj(alt, az):
        d = (az - az_center + 540.0) % 360.0 - 180.0
        return 0.5 + d / 360.0, 0.06 + 0.80 * (1.0 - alt / 90.0)

    mx, my = proj(e["alt"], e["az"])
    sx, sy = proj(e["salt"], e["saz"])
    limb = math.degrees(math.atan2((sx - mx) * (W / H), -(sy - my)))
    # Shadows fall away from the light. The same vector the Lua hands Hyprland.
    ddx, ddy = mx - 0.5, my - 0.5
    dl = math.hypot(ddx, ddy) or 1.0
    off = (int(-ddx / dl * 15), int(-ddy / dl * 15))

    base = os.path.join(TMP, "pv-bg.png")
    sky(base, glow_x=mx, glow_y=my + 0.55, stars=1.1)

    ink, dim, faint = "#d9dee8", "#9aa4b8", "#5a6a8c"
    card, edge = "#080d1a", "#cfe0f5"
    size = int(H * 0.26 * (384400.0 / e["dist"]))

    # Build the Moon and its glow as their own image, in their own invocation.
    # -geometry is consumed by the first -composite that sees it, so a nested
    # composite inside a parenthesised group silently steals the placement of
    # the one outside it. Ask once, use once.
    moon = png_of_disc("pv", size, phase=e["phase"], limb=limb, tilt=-e["q"],
                       lib_lon=e["lib_lon"], lib_lat=e["lib_lat"])
    glow = os.path.join(TMP, "pv-glow.png")
    run([MAGICK, moon, "-background", "none", "-alpha", "set",
         "-bordercolor", "none", "-border", "%d" % int(size * 0.5),
         "(", "+clone", "-blur", "0x%d" % int(size * 0.30), "-evaluate", "multiply", "0.85", ")",
         "-compose", "screen", "-composite", glow])
    gsize = size * 2

    # The cards sit in the lower two thirds and leave a corridor up the middle,
    # because that is where a Moon near its own transit ends up on this
    # projection, and the layout should get out of its way.
    x0, y0, x1, y1 = int(W * 0.045), int(H * 0.40), int(W * 0.475), int(H * 0.950)
    bx0, by0, bx1, by1 = int(W * 0.525), int(H * 0.480), int(W * 0.955), int(H * 0.965)

    args = [MAGICK, base, "-fill", "none"]
    for (a_, b_, c_, d_, hot) in ((bx0, by0, bx1, by1, False), (x0, y0, x1, y1, True)):
        args += ["-fill", "#01020699", "-stroke", "none",
                 "-draw", "roundrectangle %d,%d %d,%d 14,14" % (
                     a_ + off[0], b_ + off[1], c_ + off[0], d_ + off[1])]
        args += ["-fill", card, "-stroke", edge if hot else "#2b3d63",
                 "-strokewidth", "2",
                 "-draw", "roundrectangle %d,%d %d,%d 12,12" % (a_, b_, c_, d_)]
    args += ["-fill", "#03050a", "-stroke", "none",
             "-draw", "rectangle 0,0 %d,%d" % (W, int(H * 0.058))]

    fs = int(H * 0.0208)
    args += font_args() + ["-stroke", "none", "-gravity", "NorthWest"]
    args += ["-fill", dim, "-pointsize", str(fs),
             "-annotate", "+%d+%d" % (int(W * 0.016), int(H * 0.038)), "1  2  3  4"]
    args += ["-fill", "#cfe0f5", "-pointsize", str(fs),
             "-annotate", "+%d+%d" % (int(W * 0.108), int(H * 0.038)), "lunation"]
    args += ["-fill", ink, "-pointsize", str(fs), "-gravity", "NorthEast",
             "-annotate", "+%d+%d" % (int(W * 0.016), int(H * 0.024)),
             "%.0f%% %s     %+.0f deg alt     %.0f km" % (
                 e["k"] * 100, "waxing" if e["waxing"] else "waning", e["alt"], e["dist"])]
    args += ["-gravity", "NorthWest"]

    stamp = time.strftime("%Y-%m-%d %H:%M", time.gmtime((jd - 2440587.5) * 86400))
    lines = [
        [("#8fb4ff", "$ "), (ink, "ritzpah show lunation | jq -r .kind")],
        [("#7fd6a2", "live")],
        [],
        [("#8fb4ff", "$ "), (ink, "head -4 $(omarchy-theme-dir)/sky.frag")],
        [(dim, "#version 300 es")],
        [(dim, "// Baked %s UTC for %.4f, %.4f" % (stamp, lat, lon))],
        [(dim, "// (zoneinfo bytes). Moon: altitude %+.2f deg," % e["alt"])],
        [(dim, "// azimuth %.2f deg, %.1f%% lit and %s." % (
            e["az"], e["k"] * 100, "waxing" if e["waxing"] else "waning"))],
        [],
        [("#8fb4ff", "$ "), (dim, "# nothing schedules that. the shader is")],
        [("#8fb4ff", "$ "), (dim, "# already asked the time, 60 times a second.")],
        [],
        [("#8fb4ff", "$ "), (ink, "# borders point at it. shadows")],
        [("#8fb4ff", "$ "), (ink, "# fall away from it.")],
        [("#8fb4ff", "$ "), ("#f4f7fb", "\u2588")],
    ]
    y = y0 + int(fs * 2.4)
    left = x0 + int(fs * 1.5)
    for segments in lines:
        pen = left
        for colour, text in segments:
            args += ["-fill", colour, "-pointsize", str(fs),
                     "-annotate", "+%d+%d" % (pen, y), text]
            pen += int(len(text) * fs * 0.601)
        y += int(fs * 1.60)

    args += ["-fill", faint, "-pointsize", str(int(fs * 0.92)),
             "-annotate", "+%d+%d" % (bx0 + int(fs * 1.6), by0 + int(fs * 2.4)),
             "sky, as of this frame"]
    rows = [("altitude", "%+.2f deg" % e["alt"]), ("azimuth", "%.2f deg" % e["az"]),
            ("phase angle", "%.1f deg" % e["phase"]),
            ("illuminated", "%.1f %%" % (e["k"] * 100)),
            ("distance", "%.0f km" % e["dist"]),
            ("libration", "%+.2f / %+.2f deg" % (e["lib_lon"], e["lib_lat"])),
            ("parallactic", "%+.2f deg" % e["q"]),
            ("recomputed", "every frame, per pixel")]
    ry = by0 + int(fs * 5.2)
    for label, value in rows:
        args += ["-fill", dim, "-pointsize", str(fs),
                 "-annotate", "+%d+%d" % (bx0 + int(fs * 1.6), ry), label]
        args += ["-fill", ink, "-pointsize", str(fs),
                 "-annotate", "+%d+%d" % (bx0 + int(fs * 12.0), ry), value]
        ry += int(fs * 1.95)

    # And now the sky, over the top of all of it, the way the shader sees it.
    args += ["(", glow, ")", "-geometry",
             "+%d+%d" % (int(mx * W - gsize / 2), int(my * H - gsize / 2)),
             "-compose", "screen", "-composite"]
    out = os.path.join(TMP, "preview.png")
    args.append(out)
    run(args)
    run([MAGICK, out, "-depth", "8", "-strip",
         os.path.join(REPO, "themes/lunation/preview.png")])
    print("  -> themes/lunation/preview.png")
    W, H = keep


def main():
    os.makedirs(OUT, exist_ok=True)
    lat, lon, zone = observer()
    jd0 = jd_now()
    print("lunation wallpapers -> %s  (%dx%d)" % (OUT, W, H))
    print("observer: %.4f, %.4f (%s)" % (lat, lon, zone))
    started = time.time()
    plate_lunation(jd0)
    plate_transit(jd0, lat, lon, zone)
    plate_terminator()
    plate_earthshine()
    plate_libration(jd0)
    preview(jd0, lat, lon)
    shutil.rmtree(TMP, ignore_errors=True)
    print("done in %.0f s" % (time.time() - started))


if __name__ == "__main__":
    main()
